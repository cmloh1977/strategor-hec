rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow users to manage their own portfolio data
    // Admin can READ all users' portfolio data
    match /users/{userId}/portfolio/{document=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == "chee_ming_loh@toyota-tsusho.com");
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to manage their own chat history
    // Admin can READ all users' chat data
    match /users/{userId}/chats/{document=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == "chee_ming_loh@toyota-tsusho.com");
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Share codes: any authenticated user can read or write
    match /shareCodes/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Teams: any authenticated user can read and write
    // (team membership is validated in application code)
    match /teams/{teamCode} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Admin user registry: master admin has full access
    // Regular users can update ONLY their own password field
    match /_admin_users/{userId} {
      allow read, write: if request.auth != null && request.auth.token.email == "chee_ming_loh@toyota-tsusho.com";
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password']);
    }
    
    // Default: Deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
