rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow users to manage their own portfolio data
    match /users/{userId}/portfolio/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow users to manage their own chat history
    match /users/{userId}/chats/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Share codes: any authenticated user can read or write
    match /shareCodes/{code} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Admin user registry: only the master admin can manage
    match /_admin_users/{userId} {
      allow read, write: if request.auth != null && request.auth.token.email == "chee_ming_loh@toyota-tsusho.com";
    }
    
    // Default: Deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
